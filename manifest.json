{
  "name": "GabungVideo - Satukan Momen Tanpa Watermark",
  "short_name": "GabungVideo",
  "description": "Gabungkan video MP4 dan WebM hingga 25 menit gratis, tanpa watermark, proses di HP tanpa upload server.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#ff0055",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" },
    "enctype": "application/x-www-form-urlencoded"
  },
  "file_handlers": [
    { "action": "/", "accept": { "video/*": [".mp4", ".webm", ".mov"] } }
  ],
  "shortcuts": [
    { "name": "Gabung Video Sekarang", "url": "/", "description": "Langsung gabung video" }
  ]
}
